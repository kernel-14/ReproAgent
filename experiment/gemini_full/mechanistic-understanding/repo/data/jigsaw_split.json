        "source": "allenai/real-toxicity-prompts"
      },
      "availability_check": {
        "type": "import_check",
        "package": "datasets"
      }
    },
    "pplm_generated_pairs": {
      "id": "pplm_generated_pairs",
      "aliases": ["PPLM-generated pairs", "pairwise_toxic_data"],
      "setup_metadata": {
        "patience_value": 10,
        "approx_sample_pairs": 6700,
        "source_file": "data/pairwise_toxic_data.json"
      },
      "availability_check": {
        "type": "file_check",
        "path": "data/pairwise_toxic_data.json"
      }
    }
  },
  "environment_registry": {
    "gpt2": {
      "id": "gpt2",
      "aliases": ["GPT2", "gpt2-small"],
      "model_name": "gpt2",
      "setup_metadata": {
        "d_model": 768,
        "n_layer": 12,
        "n_head": 12
      },
      "availability_check": {
        "type": "transformers_import"
      }
    },
    "llama2": {
      "id": "llama2",
      "aliases": ["Llama2", "Llama-2-7b"],
