    "binary_toxicity_classification": {
      "id": "binary_toxicity_classification",
      "aliases": ["toxicity_classification"],
      "setup_metadata": {
        "num_classes": 2,
        "class_labels": {
          "0": "non-toxic",
          "1": "toxic"
        }
      }
    }
  },
  "experiment_registry": {
    "toxic_vector_extraction": {
      "hypothesis": "通过线性探测（Linear Probe）和MLP权重分解（SVD）可以识别出模型中负责毒性生成的特定方向，且Oracle分类器可作为评估基准",
      "decision_value": "为后续的干预实验和DPO机制分析提供基础的向量表示与评估基准",
      "metrics": ["accuracy", "f1", "precision", "recall"],
      "expected_probe_accuracy": 0.94,
      "artifacts": {
        "probe_checkpoint": "checkpoints/toxic_probe.pt",
        "metadata": "results/toxic_vectors_metadata.json",
        "table_1": "results/tables/table_1.csv",
        "table_6": "results/tables/table_6.csv",
        "figure_4": "results/figures/figure_4.png",
        "figure_6": "results/figures/figure_6.png"
      }
    },
    "dpo_alignment": {
      "hypothesis": "DPO can reduce model toxicity by suppressing the likelihood of negative samples (toxic outputs), and is sensitive to the beta parameter.",
      "loss_formula": "L_DPO = -E[log sigma(beta * log P - beta * log N)]",
      "probability_ratios": {
        "P": "pi_theta(y_+ | w) / pi_ref(y_+ | w)",
        "N": "pi_theta(y_- | w) / pi_ref(y_- | w)"
      },
      "hyperparameters": {
        "beta": 0.1
      },
      "metrics": ["loss", "perplexity", "toxicity"],
      "artifacts": {
        "gpt2_dpo_checkpoint": "checkpoints/gpt2_dpo.pt",
        "llama2_dpo_checkpoint": "checkpoints/llama2_dpo.pt",
        "table_2": "results/tables/table_2.csv",
        "table_7": "results/tables/table_7.csv",
        "figure_10": "results/figures/figure_10.png",
        "figure_11": "results/figures/figure_11.png"
      }
    },
    "mechanistic_analysis": {
      "protocols": {
        "jailbreak_attack_protocol": {
          "description": "Evaluate alignment robustness under adversarial prompts or activation manipulation."
        }
      },
      "gating_override": {
        "formula": "sigma(W1 * x) = 1",
        "description": "Un-aligning DPO via activation manipulation to restore toxicity."
      },
      "artifacts": {
        "intervention_results": "results/intervention_results.json",
        "activation_analysis": "results/activation_analysis.json",
        "unalign_results": "results/unalign_results.json",
        "table_3": "results/tables/table_3.csv",
        "table_4": "results/tables/table_4.csv",
        "figure_5": "results/figures/figure_5.png"
      }
    }
  },
  "method_obligations": {
    "oracle_toxicity_classifier": {
      "model_name": "unitary/unbiased-toxic-roberta",
      "binding_addendum_clarification": "For measuring toxicity, reproductions should use https://huggingface.co/unitary/unbiased-toxic-roberta instead of Perspective API."
    },
    "probe_training": {
      "pooling_method": "average_pooling",
      "layer": "last_layer_residual_stream",
      "formula": "P(Toxic | x_bar^{L-1}) = softmax(W_Toxic * x_bar^{L-1})",
      "w_toxic_shape_clarification": "W_toxic is a matrix of shape [d_model, 2], where W_toxic[:, 0] is for non-toxic and W_toxic[:, 1] is for toxic. Cosine similarity is computed with W_toxic[:, 1]."
    },
    "projection_logic": {
      "description": "Project toxic vectors (W_toxic[:, 1], MLP.v_toxic, SVD.U_toxic) onto the vocabulary space using the unembedding matrix U to verify semantic consistency.",
      "top_tokens_definition": "Tokens that have the highest dot-products with a specified toxic vector."
    }
  },
  "readiness_checks": {
    "environment_readiness_path": "results/environment_readiness.json",
    "environment_registry_path": "results/environment_registry.json",
    "experiment_registry_path": "results/experiment_registry.json",
    "artifact_manifest_path": "results/artifact_manifest.json",
    "dataset_registry_path": "results/dataset_registry.json",
    "data_manifest_path": "results/data_manifest.json"
  },
