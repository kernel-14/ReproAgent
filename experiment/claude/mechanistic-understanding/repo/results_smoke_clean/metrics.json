      },
      "f1": {
        "formula": "2 * precision * recall / (precision + recall)",
        "higher_is_better": true
      },
      "loss": {
        "formula": "mean binary cross entropy over calibrated toxicity probabilities",
        "higher_is_better": false
      },
      "perplexity": {
        "formula": "exp(mean token negative log likelihood)",
        "higher_is_better": false
      },
      "precision": {
        "formula": "TP / (TP + FP)",
        "higher_is_better": true
      },
      "recall": {
        "formula": "TP / (TP + FN)",
        "higher_is_better": true
      },
      "toxicity": {
        "formula": "mean calibrated probability and thresholded toxicity rate",
        "higher_is_better": false
      }
