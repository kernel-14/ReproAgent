    "metrics_json": {
      "artifact_id": "metrics_json",
      "caption": "Canonical metrics containing problem, optimizer, width, seed, iteration, loss, and L2RE.",
      "kind": "json",
      "out_of_scope": false,
      "paper_semantics": "primary per-run measurement file",
      "path": "results/metrics.json",
      "required_in_smoke": true,
      "route_name": "runtime_route_metrics_json",
      "schema": {
        "metric_schemas": {
          "L2RE": {
            "aggregation": [
              "min",
              "median",
              "final"
            ],
            "formula": "sqrt(sum_i (u_pred_i-u_ref_i)^2) / max(sqrt(sum_i u_ref_i^2), eps)",
            "required": true,
            "type": "float"
          },
          "accuracy": {
            "description": "Auxiliary evidence-contract metric; for PINNs accuracy is normally derived from relative error thresholds.",
            "required": false,
            "type": "float"
          },
          "condition_number": {
            "aggregation": [
              "per_residual_point_count",
              "per_problem"
            ],
            "formula": "kappa_L = lambda_max / max(lambda_min_positive, eps)",
            "required": false,
            "type": "float"
          },
          "fidelity_score": {
            "formula": "bounded score combining artifact completeness and trend-consistency checks",
            "required": false,
            "type": "float"
          },
          "gradient_norm": {
            "aggregation": [
              "final",
              "min"
            ],
            "required": false,
            "type": "float"
          },
          "hessian_eigenvalues": {
            "aggregation": [
              "top",
              "bottom_positive",
              "condition_proxy"
            ],
            "required": false,
            "type": "array[float]"
          },
          "loss": {
            "aggregation": [
              "min",
              "median",
              "final",
              "trajectory"
            ],
            "description": "Total PINN objective; component losses are recorded independently.",
            "required": true,
            "type": "float"
          },
          "loss_components": {
            "aggregation": [
              "component_min",
              "component_final"
            ],
            "description": "Named residual/initial/boundary/data terms before summing total loss.",
            "fields": [
              "residual",
              "initial",
              "boundary",
              "data"
            ],
            "required": true,
            "type": "object"
          },
          "precision": {
            "description": "Auxiliary evidence-contract metric retained for benchmark schema compatibility.",
            "required": false,
            "type": "float"
          },
          "return": {
            "description": "Auxiliary evidence-contract metric; not a primary PINN paper metric.",
            "required": false,
            "type": "float"
          },
          "spectral_density": {
            "aggregation": [
              "per_problem",
              "per_component"
            ],
            "fields": [
              "bins",
              "density",
              "operator",
              "loss_component"
            ],
            "required": false,
            "type": "object"
          },
          "training_time": {
            "aggregation": [
              "sum",
              "per_iteration"
            ],
            "required": false,
            "type": "float",
            "unit": "seconds"
          }
        },
        "required_fields": [
          "problem",
          "optimizer",
          "width",
          "seed",
          "iteration",
          "loss",
          "L2RE"
        ]
      },
      "writer_name": "write_metrics_json"
    },
